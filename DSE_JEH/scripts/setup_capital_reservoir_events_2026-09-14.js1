// DSE_JEH_TransSat_1 Capital Reservoir persistence setup.
// Target: bar_sequence_db.capital_reservoir_events
//
// Run manually in MongoDB Compass Shell or mongosh after reviewing this file.
// This script requires the target collection to already exist and be empty.
// It never creates, drops, renames, clears, updates, or populates a collection.

(function setupCapitalReservoirEvents() {
  "use strict";

  const DB_NAME = "bar_sequence_db";
  const TARGET_COLLECTION = "capital_reservoir_events";
  const targetDb = db.getSiblingDB(DB_NAME);
  const issues = [];

  function fail(message) {
    issues.push(message);
    print("FAIL: " + message);
  }

  function canonicalize(value) {
    if (Array.isArray(value)) {
      return value.map(canonicalize);
    }
    if (value !== null && typeof value === "object") {
      const normalized = {};
      Object.keys(value).sort().forEach(function (key) {
        normalized[key] = canonicalize(value[key]);
      });
      return normalized;
    }
    return value;
  }

  function equivalentDocument(left, right) {
    return JSON.stringify(canonicalize(left)) === JSON.stringify(canonicalize(right));
  }

  function compatibleIndex(index, expected) {
    return equivalentDocument(index.key, expected.key) &&
      Boolean(index.unique) === Boolean(expected.unique) &&
      equivalentDocument(index.partialFilterExpression, expected.partialFilterExpression) &&
      index.expireAfterSeconds === undefined &&
      index.collation === undefined &&
      index.wildcardProjection === undefined;
  }

  print("[DSE_JEH_TransSat_1] Capital Reservoir setup / verification");
  print("Database: " + DB_NAME);
  print("Target collection: " + TARGET_COLLECTION);
  print("");

  if (targetDb.getCollectionNames().indexOf(TARGET_COLLECTION) === -1) {
    fail("Required pre-existing collection '" + TARGET_COLLECTION + "' does not exist.");
    print("No collection was created and no validator or index change was attempted.");
    print("FINAL RESULT: FAIL");
    return;
  }

  const target = targetDb.getCollection(TARGET_COLLECTION);
  const documentCount = target.countDocuments({});
  print("Existing collection: PRESENT");
  print("Current document count: " + documentCount);
  if (documentCount !== 0) {
    fail("The setup contract requires an empty collection; found " + documentCount + " documents.");
    print("No validator or index change was attempted.");
    print("FINAL RESULT: FAIL");
    return;
  }

  const numericType = ["double", "decimal", "int", "long"];
  const nullableDate = ["date", "null"];
  const expectedValidator = {
    $jsonSchema: {
      bsonType: "object",
      required: [
        "pipeline_run_id",
        "collection_run_id",
        "run_type",
        "event_sequence",
        "event_type",
        "stage_emit_value_id",
        "trigger_event_time",
        "execution_event_time",
        "processed_at",
        "reservoir_before",
        "reservoir_after"
      ],
      properties: {
        pipeline_run_id: { bsonType: "string", minLength: 1 },
        collection_run_id: { bsonType: "string", minLength: 1 },
        run_type: { bsonType: "string", minLength: 1, pattern: "^[A-Z0-9][A-Z0-9_-]*$" },
        event_sequence: { bsonType: ["int", "long"], minimum: 1 },
        symbol: { bsonType: "string", minLength: 1 },
        event_type: { bsonType: "string", enum: ["RUN_START", "OUTFLOW", "INFLOW", "RUN_END"] },
        cause: { bsonType: "string", enum: ["HOP_ON", "HOP_OFF", "SAFETY_LIQUIDATION"] },
        stage_emit_value_id: { bsonType: ["objectId", "null"] },
        trigger_event_time: { bsonType: nullableDate },
        execution_event_time: { bsonType: nullableDate },
        processed_at: { bsonType: "date" },
        quantity: { bsonType: ["int", "long"], minimum: 1 },
        execution_price: { bsonType: numericType, minimum: 0, exclusiveMinimum: true },
        signed_flow_amount: { bsonType: numericType },
        initial_reservoir: { bsonType: numericType, minimum: 0 },
        symbol_count: { bsonType: ["int", "long"], minimum: 1 },
        initial_symbol_capital: { bsonType: numericType, minimum: 0, exclusiveMinimum: true },
        reservoir_before: { bsonType: numericType, minimum: 0 },
        reservoir_after: { bsonType: numericType, minimum: 0 },
        active_quantity_after: { bsonType: ["int", "long"], minimum: 0 },
        reservoir_cash: { bsonType: numericType, minimum: 0 },
        total_deployed_after: { bsonType: numericType, minimum: 0 },
        total_marked_capital_after: { bsonType: numericType, minimum: 0 },
        realized_pnl: { bsonType: numericType },
        unrealized_pnl: { bsonType: numericType },
        total_pnl: { bsonType: numericType },
        active_positions: { bsonType: ["int", "long"], minimum: 0 }
      },
      oneOf: [
        {
          required: ["initial_reservoir", "symbol_count", "initial_symbol_capital"],
          properties: {
            event_type: { enum: ["RUN_START"] },
            stage_emit_value_id: { bsonType: "null" },
            trigger_event_time: { bsonType: "null" },
            execution_event_time: { bsonType: "null" }
          }
        },
        {
          required: ["symbol", "cause", "quantity", "execution_price", "signed_flow_amount", "active_quantity_after"],
          properties: {
            event_type: { enum: ["OUTFLOW"] },
            cause: { enum: ["HOP_ON"] },
            stage_emit_value_id: { bsonType: "objectId" },
            trigger_event_time: { bsonType: "date" },
            execution_event_time: { bsonType: "date" },
            signed_flow_amount: { bsonType: numericType, maximum: 0, exclusiveMaximum: true }
          }
        },
        {
          required: ["symbol", "cause", "quantity", "execution_price", "signed_flow_amount", "active_quantity_after"],
          properties: {
            event_type: { enum: ["INFLOW"] },
            cause: { enum: ["HOP_OFF", "SAFETY_LIQUIDATION"] },
            stage_emit_value_id: { bsonType: "objectId" },
            trigger_event_time: { bsonType: "date" },
            execution_event_time: { bsonType: "date" },
            signed_flow_amount: { bsonType: numericType, minimum: 0, exclusiveMinimum: true }
          }
        },
        {
          required: [
            "reservoir_cash",
            "total_deployed_after",
            "total_marked_capital_after",
            "realized_pnl",
            "unrealized_pnl",
            "total_pnl",
            "active_positions"
          ],
          properties: {
            event_type: { enum: ["RUN_END"] },
            stage_emit_value_id: { bsonType: "null" },
            trigger_event_time: { bsonType: "null" },
            execution_event_time: { bsonType: "null" }
          }
        }
      ]
    }
  };

  const collModResult = targetDb.runCommand({
    collMod: TARGET_COLLECTION,
    validator: expectedValidator,
    validationLevel: "strict",
    validationAction: "error"
  });
  if (collModResult.ok !== 1) {
    fail("collMod did not succeed: " + EJSON.stringify(collModResult));
  } else {
    print("Applied strict Capital Reservoir validator.");
  }

  const expectedIndexes = [
    {
      name: "ux_reservoir_pipeline_event_sequence",
      key: { pipeline_run_id: 1, event_sequence: 1 },
      unique: true
    },
    {
      name: "ux_reservoir_stage_emit_value",
      key: { stage_emit_value_id: 1 },
      unique: true,
      partialFilterExpression: { stage_emit_value_id: { $type: "objectId" } }
    },
    {
      name: "ix_reservoir_run_type_pipeline",
      key: { run_type: 1, pipeline_run_id: 1 }
    },
    {
      name: "ix_reservoir_pipeline_symbol_execution_time",
      key: { pipeline_run_id: 1, symbol: 1, execution_event_time: 1 }
    },
    {
      name: "ix_reservoir_pipeline_event_type",
      key: { pipeline_run_id: 1, event_type: 1 }
    }
  ];

  if (issues.length === 0) {
    expectedIndexes.forEach(function (expected) {
      const options = { name: expected.name };
      if (expected.unique) {
        options.unique = true;
      }
      if (expected.partialFilterExpression) {
        options.partialFilterExpression = expected.partialFilterExpression;
      }
      target.createIndex(expected.key, options);
    });
  }

  const collectionInfo = targetDb.getCollectionInfos({ name: TARGET_COLLECTION })[0];
  if (!collectionInfo || !equivalentDocument(collectionInfo.options.validator, expectedValidator)) {
    fail("Installed validator does not match the expected Capital Reservoir validator.");
  } else if (collectionInfo.options.validationLevel !== "strict" || collectionInfo.options.validationAction !== "error") {
    fail("Validation level/action is not strict/error.");
  } else {
    print("Verified strict Capital Reservoir validator.");
  }

  const installedIndexes = target.getIndexes();
  expectedIndexes.forEach(function (expected) {
    const installed = installedIndexes.find(function (index) { return index.name === expected.name; });
    if (!installed) {
      fail("Missing required index '" + expected.name + "'.");
    } else if (!compatibleIndex(installed, expected)) {
      fail("Index '" + expected.name + "' exists with an incompatible definition.");
    } else {
      print("Verified " + expected.name + ".");
    }
  });

  print("");
  print("Resulting indexes:");
  print(EJSON.stringify(installedIndexes, null, 2));
  print("");
  print("Safety summary:");
  print("  Existing collection was required and remained empty.");
  print("  No collection was created, dropped, renamed, cleared, updated, or populated.");
  print("  stage_emit_value_id is validated as BSON ObjectId for OUTFLOW/INFLOW and indexed uniquely.");
  print("Failures: " + issues.length);
  print("FINAL RESULT: " + (issues.length === 0 ? "PASS" : "FAIL"));
}());
